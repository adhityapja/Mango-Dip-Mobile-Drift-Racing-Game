# =========================================================================
# Unity .gitignore
# =========================================================================

# Unity generated cache & temporary folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Visual Studio & IDE cache / generated solution files
.vs/
.vsconfig
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity crash reports
sysinfo.txt

# Burst debug information
*_BurstDebugInformation_DoNotShip/

# Gradle cache directory
.gradle/

# OS generated files
.DS_Store
Thumbs.db
desktop.ini
